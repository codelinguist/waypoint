# Copy this file to .env and adjust values for local development.
# .env is gitignored; never commit real credentials.

DB_NAME=waypoint
DB_USER=waypoint
DB_PASSWORD=waypoint
DB_PORT=5432
SERVER_PORT=8080

# Financial-position frontend (WAP-15). The household must already exist
# (create it via the API first, see README.md); the frontend never creates
# one. Leave unset to see the app's missing-configuration state.
FRONTEND_PORT=5173
HOUSEHOLD_ID=
